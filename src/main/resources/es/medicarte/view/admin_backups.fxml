<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.medicarte.controller.AdminBackupsController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Backups"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TitledPane text="Realizar copia de seguridad" expanded="true">
        <VBox spacing="10">
            <Label text="Última copia realizada hace 9 días"/>
            <Button text="Realizar copia" onAction="#crearBackup"/>
        </VBox>
    </TitledPane>

    <TitledPane text="Restaurar copia de seguridad">
        <VBox spacing="10">
            <ComboBox fx:id="cmbBackups"/>
            <Button text="Restaurar copia" onAction="#restaurarBackup"/>
        </VBox>
    </TitledPane>

</VBox>

