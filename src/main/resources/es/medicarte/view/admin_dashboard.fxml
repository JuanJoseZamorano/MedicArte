<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.medicarte.controller.AdminDashboardController">

    <!-- ================= MENÚ LATERAL ================= -->
    <left>
        <VBox prefWidth="220" spacing="20"
              style="-fx-background-color: #dff7f8;">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>

            <!-- Logo -->
            <VBox spacing="10" alignment="CENTER">
                <ImageView fitWidth="120" preserveRatio="true"/>
                <Label text="MedicArte"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>

            <Separator/>

            <Button text="Configuración"
                    prefHeight="50"
                    onAction="#mostrarConfiguracion"/>

            <Button text="Backups"
                    prefHeight="50"
                    onAction="#mostrarBackups"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Cerrar sesión"
                    onAction="#cerrarSesion"/>
        </VBox>
    </left>

    <!-- ================= CONTENIDO ================= -->
    <center>
        <StackPane fx:id="contentPane"
                   style="-fx-background-color: #ffffff;">
            <!-- Aquí se cargan Configuración / Backups -->
        </StackPane>
    </center>

</BorderPane>

