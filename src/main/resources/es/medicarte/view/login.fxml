<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.medicarte.controller.LoginController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
   <ImageView fx:id="imgLogo" fitHeight="120.0" fitWidth="120.0" preserveRatio="true" />
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="MedicArte" />

    <TextField fx:id="txtUser" promptText="Usuario" />

    <PasswordField fx:id="txtPassword" promptText="Contraseña" />

<!--    Convertimos el unico boton que tenemos ne defaul para que le "enter" accione le boton.-->
    <Button defaultButton="true" onAction="#handleLogin" text="Entrar" />

</VBox>
