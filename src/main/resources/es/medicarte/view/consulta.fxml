<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.medicarte.controller.ConsultaController">

    <!-- ================= CABECERA ================= -->
    <top>
        <VBox spacing="5">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label fx:id="lblPaciente" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Paciente" />

            <HBox spacing="20">
                <Label fx:id="lblEdadSexo" text="Edad / Sexo" />
                <Label fx:id="lblFechaHora" text="Fecha / Hora" />
                <Label fx:id="lblEspecialidad" text="Especialidad" />
                <Label fx:id="lblEpisodio" text="Episodio" />
                <ComboBox fx:id="cmbEpisodio" prefWidth="150.0" />
            </HBox>
        </VBox>
    </top>

    <!-- ================= HISTÓRICO / EPISODIO ================= -->
    <left>
        <TabPane prefHeight="494.0" prefWidth="350" side="BOTTOM">

            <Tab text="Historia">
                <VBox spacing="10">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>

                    <Label style="-fx-font-weight: bold;" text="Consultas previas del episodio" />

                    <ListView fx:id="listConsultasPrevias" prefHeight="603.0" prefWidth="330.0" />
                </VBox>
            </Tab>

            <Tab text="Antecedentes personales">
                <TextArea fx:id="txtAntPersonales" editable="false" wrapText="true" />
            </Tab>

            <Tab text="Antecedentes familiares">
                <TextArea fx:id="txtAntFamiliares" editable="false" wrapText="true" />
            </Tab>

            <Tab text="Alergias">
                <TextArea fx:id="txtAlergias" editable="false" wrapText="true" />
            </Tab>

            <Tab text="Tratamiento actual">
                <TextArea fx:id="txtTratamientoActual" editable="false" wrapText="true" />
            </Tab>

        </TabPane>
    </left>

    <!-- ================= CONSULTA ACTUAL ================= -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Consulta actual" />

            <Label text="Motivo de consulta" />
            <TextArea fx:id="txtMotivoConsulta" prefRowCount="2" wrapText="true" />

            <TabPane>

                <Tab text="Anamnesis">
                    <TextArea fx:id="txtAnamnesis" prefHeight="250.0" prefWidth="478.0" wrapText="true" />
                </Tab>

                <Tab text="Exploración">
                    <TextArea fx:id="txtExploracion" wrapText="true" />
                </Tab>

                <Tab text="Diagnóstico">
                    <TextArea fx:id="txtDiagnostico" wrapText="true" />
                </Tab>

                <Tab text="Tratamiento">
                    <TextArea fx:id="txtTratamiento" wrapText="true" />
                </Tab>

            </TabPane>

            <Label text="Observaciones" />
            <TextArea fx:id="txtObservaciones" prefHeight="113.0" prefRowCount="2" prefWidth="478.0" wrapText="true" />

        </VBox>
    </center>

    <!-- ================= BOTONERA ================= -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Button onAction="#cancelar" text="Cancelar" />
            <Button onAction="#limpiarConsulta" text="Limpiar consulta" />
            <Button onAction="#grabarConsulta" style="-fx-text-fill: green; -fx-font-weight: bold;" text="Grabar consulta" />
        </HBox>
    </bottom>

</BorderPane>
