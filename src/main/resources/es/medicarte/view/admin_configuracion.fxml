<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="25"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.medicarte.controller.AdminConfiguracionController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- ================= TÍTULO ================= -->
    <Label text="Configuración del sistema"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- ================= BLOQUE 1: ALTA DE USUARIO ================= -->
    <TitledPane text="Alta de usuario" expanded="true">
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150"/>
                <ColumnConstraints minWidth="250"/>
            </columnConstraints>

            <!-- Usuario -->
            <Label text="Usuario"/>
            <TextField fx:id="txtUsuario" GridPane.columnIndex="1"/>

            <!-- Contraseña -->
            <Label text="Contraseña" GridPane.rowIndex="1"/>
            <PasswordField fx:id="txtPassword"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

            <!-- Rol -->
            <Label text="Rol" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cmbRol"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="2"/>

            <!-- ===== DATOS MÉDICO (CONDICIONALES) ===== -->
            <Label text="Nombre y apellidos"
                   GridPane.rowIndex="3"/>
            <TextField fx:id="txtNombreMedico"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"/>

            <Label text="Nº colegiado"
                   GridPane.rowIndex="4"/>
            <TextField fx:id="txtNumColegiado"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="4"/>

            <Label text="Especialidad"
                   GridPane.rowIndex="5"/>
            <ComboBox fx:id="cmbEspecialidad"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="5"/>

            <!-- Botón crear -->
            <Button text="Crear usuario"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="6"
                    onAction="#crearUsuario"/>
        </GridPane>
    </TitledPane>

    <!-- ================= BLOQUE 2: ELIMINAR USUARIO ================= -->
    <TitledPane text="Eliminar usuario">
        <VBox spacing="10">
            <ComboBox fx:id="cmbUsuarios"/>
            <Button text="Eliminar usuario"
                    onAction="#eliminarUsuario"/>
        </VBox>
    </TitledPane>

    <!-- ================= BLOQUE 3: CONFIGURACIÓN CLÍNICA ================= -->
    <TitledPane text="Configuración de la clínica">
        <VBox spacing="10">

            <!-- Nombre clínica -->
            <HBox spacing="10">
                <TextField fx:id="txtNombreClinica"
                           promptText="Nombre de la clínica"/>
                <Button text="Cambiar nombre"
                        onAction="#cambiarNombreClinica"/>
            </HBox>

            <!-- Logo clínica -->
            <HBox spacing="10">
                <Label text="Logo de la clínica"/>
                <Button text="Cambiar logo"
                        onAction="#cambiarLogoClinica"/>
            </HBox>

        </VBox>
    </TitledPane>

</VBox>
